# Required: your Discord bot token from https://discord.com/developers/applications
BOT_TOKEN=your_discord_bot_token_here

# Optional: default command prefix for new servers (servers can override with /config prefix)
DEFAULT_PREFIX=-

# Optional: SQLite file path for per-server configuration and session links
DATABASE_PATH=data/bot.db

# Optional: set to a single Guild ID only for instant dev slash-command sync (0 = global sync)
GUILD_ID=0
